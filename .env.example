# Contact form settings. On Vercel, add these under
# Project > Settings > Environment Variables, then redeploy.
# Never commit real values. This file only shows the names.

# --- SMTP server ---
# Gmail: smtp.gmail.com, port 465. Use an App Password, not the normal password:
#        Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for port 465, false for 587 (optional; worked out from the port if empty)
SMTP_SECURE=
SMTP_USER=monikashyap902@gmail.com
SMTP_PASS=

# --- Where form messages go ---
CONTACT_TO_EMAIL=monikashyap902@gmail.com
# Optional sender line. Leave empty to send from SMTP_USER.
CONTACT_FROM_EMAIL=
